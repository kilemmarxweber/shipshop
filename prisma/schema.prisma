  phone        String?
  idNumber     String?
  idFrontUrl   String?
  idBackUrl    String?
  selfieUrl    String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?       @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectReason String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@map("seller_kyc")
}

enum PlatformFeeKind {
  SALE
  SHIPPING
  WITHDRAWAL
  TICKET
}

enum WalletBucket {
  BUYER
  VENDOR
  COURIER
}

enum WithdrawalStatus {
  PENDING
  PAID
  FAILED
}

model PlatformTreasury {
  id       String @id @default("chipshop")
  usdCents Int    @default(0)
  cdfCents Int    @default(0)
  kwCents  Int    @default(0)
  updatedAt DateTime @updatedAt

  @@map("platform_treasury")
}

model PlatformFee {
  id             String          @id @default(cuid())
  kind           PlatformFeeKind
  amountCents    Int
  currency       String          @default("USD")
  amountUsdCents Int
  reversedAt     DateTime?
  orderId        String?
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  withdrawalId   String?
  withdrawal     Withdrawal?     @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)
  shopId         String?
  courierId      String?
  ticketId       String?
  ticket         Ticket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())

  @@unique([orderId, kind])
  @@unique([ticketId, kind])
  @@index([kind, createdAt])
  @@index([shopId])
  @@map("platform_fee")
}

model Withdrawal {
  id                   String           @id @default(cuid())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bucket               WalletBucket
  currency             String           @default("USD")
  grossCents           Int
  feeCents             Int              @default(0)
  netCents             Int
  status               WithdrawalStatus @default(PENDING)
  provider             MobileMoneyProvider
  phone                String
  clientIdempotencyKey String?          @unique
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  paidAt               DateTime?
  platformFees         PlatformFee[]

  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("withdrawal")
}

model AppNotice {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@map("app_notice")
}

enum PromoStatus {
  ACTIVE
  ENDED
  CANCELLED
  FLAGGED
}

model ProductPromo {
  id                   String      @id @default(cuid())
  shopId               String
  shop                 Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId            String
  product              Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  percent              Int
  tier                 String
  startsAt             DateTime
  endsAt               DateTime?
  status               PromoStatus @default(ACTIVE)
  compareAtSnapshot    Int
  flagged              Boolean     @default(false)
  clientIdempotencyKey String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  ledgers              ShipPointLedger[]

  @@unique([shopId, clientIdempotencyKey])
  @@index([productId, status])
  @@index([shopId, status, startsAt])
  @@map("product_promo")
}

model ProductPriceHistory {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  shopId     String
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  priceCents Int
  recordedAt DateTime @default(now())

  @@index([productId, recordedAt])
  @@map("product_price_history")
}

model ShipPointLedger {
  id        String        @id @default(cuid())
  shopId    String
  shop      Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  promoId   String?
  promo     ProductPromo? @relation(fields: [promoId], references: [id], onDelete: SetNull)
  orderId   String?
  createdAt DateTime      @default(now())

  @@unique([orderId, reason])
  @@index([shopId, createdAt])
  @@index([promoId])
  @@map("ship_point_ledger")
}

model ShopRewardState {
  shopId                    String   @id
  shop                      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  pointsBalance             Int      @default(0)
  sellerTier                String   @default("BRONZE")
  commissionGrantRemaining  Int      @default(0)
  commissionBpsOff          Int      @default(0)
  shipCashMonthCents        Int      @default(0)
  shipCashMonthKey          String   @default("")
  updatedAt                 DateTime @updatedAt

  @@map("shop_reward_state")
}

enum EventStatus {
  DRAFT
  ON_SALE
  CLOSED
  CANCELLED
  ENDED
}

enum EventOrganizerKind {
  ARTIST
  ORGANIZATION
}

enum PlatformTicketFeeMode {
  PERCENT
  FLAT
}

enum TicketStatus {
  PAID
  CHECKED_IN
  REFUNDED
  VOID
}

enum TicketRefundStatus {
  PENDING
  APPROVED
  REJECTED
}

model Event {
  id                 String               @id @default(cuid())
  title              String
  description        String               @default("")
  imageUrl           String?
  venue              String
  city               String
  currency           String               @default("USD")
  /// Taux du jour figé à la création : 1 $US = N CDF
  fxCdfPerUsd        Int                  @default(2400)
  /// Taux du jour figé à la création : 1 $US = N KW
  fxKwPerUsd         Int                  @default(1)
  fxRateUpdatedAt    DateTime?
  capacity           Int?
  accessNote         String?
  status             EventStatus          @default(DRAFT)
  organizerKind      EventOrganizerKind   @default(ARTIST)
  organizerName      String
  organizerUserId    String
  organizer          User                 @relation("EventOrganizer", fields: [organizerUserId], references: [id], onDelete: Restrict)
  createdByUserId    String
  createdBy          User                 @relation("EventCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  platformFeeMode    PlatformTicketFeeMode @default(PERCENT)
  platformFeeBps     Int                  @default(1000)
  platformFeeCents   Int                  @default(0)
  startsAt           DateTime
  endsAt             DateTime
  salesStartsAt      DateTime?
  salesEndsAt        DateTime?
  accessStartsAt     DateTime?
  accessEndsAt       DateTime?
  settledAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  ticketTypes        TicketType[]
  tickets            Ticket[]
  campaigns          BrandCampaign[]
  challenges         DailyChallenge[]

  @@index([status, startsAt])
  @@index([organizerUserId])
  @@index([createdByUserId])
  @@map("event")
}

model TicketType {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String
  description String  @default("")
  priceCents Int
  quota      Int
  soldCount  Int      @default(0)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tickets    Ticket[]

  @@index([eventId])
  @@map("ticket_type")
}

model Ticket {
  id               String        @id @default(cuid())
  eventId          String
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  typeId           String
  type             TicketType    @relation(fields: [typeId], references: [id], onDelete: Restrict)
  buyerUserId      String
  buyer            User          @relation("TicketBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  status           TicketStatus  @default(PAID)
  currency         String        @default("USD")
  purchaseCents    Int
  platformFeeCents Int
  organizerCents   Int
  qrPayload        String
  qrHmac           String
  code             String
  checkedInAt      DateTime?
  checkedInById    String?
  checkedInBy      User?         @relation("TicketChecker", fields: [checkedInById], references: [id], onDelete: SetNull)
  settledAt        DateTime?
  clawbackFailed   Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  refundRequests   TicketRefundRequest[]
  platformFees     PlatformFee[]

  @@unique([code])
  @@index([eventId, status])
  @@index([buyerUserId, createdAt])
  @@index([qrHmac])
  @@map("ticket")
}

model TicketRefundRequest {
  id           String             @id @default(cuid())
  ticketId     String
  ticket       Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  buyerUserId  String
  buyer        User               @relation("TicketRefundBuyer", fields: [buyerUserId], references: [id], onDelete: Cascade)
  reason       String
  status       TicketRefundStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?              @relation("TicketRefundReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([ticketId])
  @@map("ticket_refund_request")
}
