  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  earnedAt  DateTime         @default(now())
  lostAt    DateTime?
  active    Boolean          @default(true)
  cycleKey  String?

  @@unique([userId, kind])
  @@index([kind, active])
  @@map("account_badge")
}

model UserActivityDay {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day           DateTime @db.Date
  interactions  Int      @default(0)
  city          String?
  createdAt     DateTime @default(now())

  @@unique([userId, day])
  @@index([day, interactions])
  @@index([city, day])
  @@map("user_activity_day")
}

model UserMissionProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionKey  String
  periodKey   String
  progress    Int       @default(0)
  target      Int
  completedAt DateTime?

  @@unique([userId, missionKey, periodKey])
  @@index([periodKey, completedAt])
  @@map("user_mission_progress")
}

model RewardGrant {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  title       String
  createdAt   DateTime  @default(now())
  consumedAt  DateTime?

  @@index([userId, createdAt])
  @@map("reward_grant")
}

model UserFollow {
  id         String   @id @default(cuid())
  followerId String
  follower   User     @relation("CreatorFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    User     @relation("CreatorFollowers", fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, creatorId])
  @@index([creatorId])
  @@map("user_follow")
}

model DailyChallenge {
  id                 String    @id @default(cuid())
  title              String
  body               String
  category           String?
  city               String?
  startsAt           DateTime
  endsAt             DateTime
  /// none | catalog | teaser — ancrage produit du challenge
  productFocus       String    @default("none")
  /// Produit publié (focus=catalog) → CTA fiche
  productId          String?
  product            Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Snapshot hors catalogue (focus=teaser) : title, image, priceCents, currency, shopName, note
  productTeaser      Json?
  /// Média hero du challenge : { url, kind: image|video, posterUrl? } — jpg/png/webp/mp4/webm
  spotlight          Json?
  /// Événement billetterie lié — « Je relève » ouvre la fiche Event
  eventId            String?
  event              Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sponsorCampaignId  String?
  sponsorCampaign    BrandCampaign? @relation(fields: [sponsorCampaignId], references: [id], onDelete: SetNull)
  completions        Int       @default(0)
  createdAt          DateTime  @default(now())

  done ChallengeCompletion[]

  @@index([startsAt, endsAt])
  @@index([productId])
  @@index([eventId])
  @@map("daily_challenge")
}

model ChallengeCompletion {
  id          String         @id @default(cuid())
  /// Réf. publique (ex. CHL-A7K2M9) pour le rapport demandeur
  reference   String         @unique
  challengeId String
  challenge   DailyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())

  @@unique([challengeId, userId])
  @@index([challengeId, createdAt])
  @@map("challenge_completion")
}

model CreatorLive {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  productId        String?
  product          Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// LIVE | PAUSED | ENDED
  status           String    @default("LIVE")
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  pausedAt         DateTime?
  /// connection | host | system
  pauseReason      String?
  /// normal | pause_timeout | host | connection
  endReason        String?
  lastHeartbeatAt  DateTime  @default(now())
  /// Durée prévue (minutes) — alerte host avant la fin
  plannedMinutes   Int       @default(60)
  cameraOn         Boolean   @default(true)
  micOn            Boolean   @default(true)
  viewerPeak       Int       @default(0)
  giftCents        Int       @default(0)
  /// J’aime viewers (double-tap / bouton cœur)
  likeCount        Int       @default(0)
  /// Fond décoratif CSS (aurora | sunset | …) — session live uniquement
  backdropPreset   String?
  /// Image de fond custom (/uploads/…) — fichier supprimé à la fin du live
  backdropUrl      String?
  /// Filtre vidéo (natural | hd | studio | …) — défaut natural
  videoFilter      String?
  /// Disposition scène multi-invités : rail | split | board
  stageLayout      String    @default("rail")
  /// true = personne ne peut demander à monter
  guestJoinLocked  Boolean   @default(false)
  /// Stickers texte + cartes produit (x/y/scale %) visibles par les viewers
  overlays         Json      @default("[]")
  /// Diffuseur a ouvert le catalogue — viewers voient la même liste
  catalogOpen      Boolean   @default(false)
  /// Fiche produit présentée aux viewers (null = liste seule)
  presentedProductId String?

  gifts    CreatorGift[]
  chats    LiveChatMessage[]
  guests   LiveGuest[]
  rtcSignals LiveRtcSignal[]

  @@index([status, startedAt])
  @@index([userId, status])
  @@map("creator_live")
}

/// Follower / invité live (demande viewer OU invitation host)
model LiveGuest {
  id          String      @id @default(cuid())
  liveId      String
  live        CreatorLive @relation(fields: [liveId], references: [id], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// PENDING (viewer→host) | INVITED (host→viewer) | ON_STAGE | REFUSED | LEFT
  status      String      @default("PENDING")
  cameraOn    Boolean     @default(false)
  micOn       Boolean     @default(false)
  /// Main levée — demande la parole (multi-invités)
  handRaised  Boolean     @default(false)
  /// Parole accordée par le diffuseur (micro autorisé en mode multi)
  hasFloor    Boolean     @default(false)
  requestedAt DateTime    @default(now())
  decidedAt   DateTime?
  leftAt      DateTime?

  @@unique([liveId, userId])
  @@index([liveId, status])
  @@map("live_guest")
}

/// Offre / réponse / candidats ICE entre peers (host, invités, viewers)
model LiveRtcSignal {
  id          String      @id @default(cuid())
  liveId      String
  live        CreatorLive @relation(fields: [liveId], references: [id], onDelete: Cascade)
  fromPeerId  String
  toPeerId    String
  /// offer | answer | ice
  kind        String
  payload     Json
  createdAt   DateTime    @default(now())
  consumedAt  DateTime?

  @@index([liveId, toPeerId, consumedAt])
  @@index([createdAt])
  @@map("live_rtc_signal")
}

model CreatorGift {
  id                   String      @id @default(cuid())
  fromUserId           String
  from                 User        @relation("GiftsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId             String
  to                   User        @relation("GiftsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  liveId               String?
  live                 CreatorLive? @relation(fields: [liveId], references: [id], onDelete: SetNull)
  kind                 String
  amountCents          Int
  currency             String      @default("USD")
  clientIdempotencyKey String?     @unique
  createdAt            DateTime    @default(now())

  @@index([toUserId, createdAt])
  @@index([fromUserId, createdAt])
  @@index([liveId])
  @@map("creator_gift")
}

model LiveChatMessage {
  id        String      @id @default(cuid())
  liveId    String
  live      CreatorLive @relation(fields: [liveId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime    @default(now())

  @@index([liveId, createdAt])
  @@map("live_chat_message")
}

/// Reçu / preuve de remise (retrait boutique OU livraison) — QR à scanner
model PickupReceipt {
  id         String    @id @default(cuid())
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  code       String    @unique
