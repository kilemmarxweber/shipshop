// Chip Shop — Prisma schema (Better Auth + domain)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth core ───────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  phone         String?
  locale        String?   @default("fr")
  theme         String?   @default("dark")
  disabledAt        DateTime?
  disabledReason    String?
  nsfwStrikeCount   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions          Session[]
  accounts          Account[]
  members           Member[]
  invitations       Invitation[]
  wallet            Wallet?
  orders            Order[]         @relation("BuyerOrders")
  cartItems         CartItem[]
  likes             ProductLike[]
  conversationsBuy  Conversation[]  @relation("ConversationBuyer")
  messagesSent      Message[]
  deliveryEvents    DeliveryEvent[]
  sellerKyc         SellerKyc?
  kycReviews        SellerKyc[]     @relation("KycReviewer")
  ownedShops        Shop[]          @relation("ShopOwner")
  shopFollows       ShopFollow[]
  productShares     ProductShare[]
  comments          ProductComment[]
  commentReads      ProductCommentRead[]
  moderationEvents  MediaModerationEvent[]
  mediaReviews      MediaReview[]
  wantedRequests    WantedRequest[]
  wantedOffers      WantedOffer[]
  moneyContacts     UserMoneyContact[]
  soundtracks       Soundtrack[]
  movementsPaid     MoneyMovement[]  @relation("MovementPayer")
  movementsReceived MoneyMovement[]  @relation("MovementBeneficiary")
  paymentAudits     PaymentAudit[]
  shopHandovers     ShopHandover[]
  productDwells     ProductDwell[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id @default(cuid())
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Better Auth organization plugin ────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String
  logo      String?
  metadata  String?
  createdAt DateTime @default(now())

  members          Member[]
  invitations      Invitation[]
  shops            Shop[]
  messagingConfig  MessagingConfig?
  messageTemplates MessageTemplate[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String   @default("member")
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String   @default("pending")
  expiresAt      DateTime
  inviterId      String
  user           User     @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ─── Domain: shops & catalog ────────────────────────────────────────

model Shop {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerUserId    String?
  owner          User?    @relation("ShopOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  name           String
  slug           String
  description    String?
  logoUrl        String?
  /// Monnaie d’affichage boutique : CDF, USD ou KW
  currency       String   @default("USD")
  /// Taux du jour : 1 $US = N CDF (ex. 2400 → 30 $US = 72 000 CDF)
  fxCdfPerUsd    Int      @default(2400)
  /// Taux du jour : 1 $US = N KW
  fxKwPerUsd     Int      @default(1)
  fxRateUpdatedAt DateTime?
  lat            Float    @default(-4.305)
  lng            Float    @default(15.311)
  isActive       Boolean  @default(true)
  /// Vitrine auto pour céder un article d’occasion (sans boutique magasin)
  isOccasionStall Boolean @default(false)
  /// Toujours disponible (retrait / préparation). Optionnel.
  alwaysOpen     Boolean  @default(false)
  /// Heure d’ouverture HH:mm (Kinshasa). Null si alwaysOpen ou non renseigné.
  hoursStart     String?
  /// Heure de fermeture HH:mm. Affichée au client sur les commandes.
  hoursEnd       String?
  /// Jours JS 0=dim … 6=sam. [] = non renseigné.
  workDays       Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products      Product[]
  orders        Order[]
  conversations Conversation[]
  followers     ShopFollow[]
  couriers      Courier[]
  deliveryRates ShopDeliveryRate[]
  wantedOffers  WantedOffer[]
  handovers     ShopHandover[]

  @@unique([organizationId, slug])
  /// Deux boutiques ne peuvent pas porter le même nom (plateforme)
  @@unique([name])
  @@index([organizationId])
  @@index([ownerUserId])
  @@map("shop")
}

model ShopFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, shopId])
  @@index([shopId])
  @@map("shop_follow")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  SOLD
  HIDDEN
}

enum MediaModerationDecision {
  ALLOW
  REJECT
  BAN
  CSAM_HOLD
}

model MediaModerationEvent {
  id          String                   @id @default(cuid())
  userId      String
  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant     String
  kind        String
  decision    MediaModerationDecision
  labels      Json
  score       Float
  contentHash String
  createdAt   DateTime                 @default(now())

  @@index([userId, createdAt])
  @@index([decision, createdAt])
  @@map("media_moderation_event")
}

/// Interrupteur Config système / Sanity (owner).
model ContentSourceConfig {
  id         String   @id @default("default")
  source     String   @default("system")
  nsfwReview Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@map("content_source_config")
}

/// File de revue humaine (pas de fichier pornographique stocké).
model MediaReview {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  variant     String
  contentHash String
  note        String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
  @@map("media_review")
}

model Product {
  id          String        @id @default(cuid())
  shopId      String
  shop        Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priceCents  Int
  quantity    Int           @default(1)
  currency    String        @default("USD")
  category    String
  images      String[]
  /// Ken Burns / travellings, 1 style par image (même ordre que images).
  imageMotions String[]     @default([])
  colors      String[]      @default([])
  sizes       String[]      @default([])
  status      ProductStatus @default(DRAFT)
  location    String?
  protectionFeeCents Int?
  shippingCents      Int?
  /// Snapshot créé quand une demande « Je cherche » est acceptée
  wantedRequestId String? @unique
  wantedRequest   WantedRequest? @relation(fields: [wantedRequestId], references: [id], onDelete: SetNull)
  soundtrackId      String?
  soundtrack        Soundtrack? @relation(fields: [soundtrackId], references: [id], onDelete: SetNull)
  soundtrackStartMs Int         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orders        Order[]
  cartItems     CartItem[]
  likes         ProductLike[]
  comments      ProductComment[]
  conversations Conversation[]
  shares        ProductShare[]
  dwells        ProductDwell[]
  wantedOffer   WantedOffer?

  @@index([category, status])
  @@index([shopId, status])
  @@map("product")
}

model ProductLike {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
  @@map("product_like")
}

/// Temps passé à regarder un produit (fiche ou feed).
model ProductDwell {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  dwellMs    Int      @default(0)
  viewCount  Int      @default(1)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, dwellMs])
  @@index([productId])
  @@map("product_dwell")
}

model ProductShare {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
  @@map("product_share")
}

model ProductComment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
  reads     ProductCommentRead[]

  @@index([productId, createdAt])
  @@index([userId])
  @@map("product_comment")
}

model ProductCommentRead {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   ProductComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, commentId])
  @@index([userId])
  @@map("product_comment_read")
}

model Soundtrack {
  id         String    @id @default(cuid())
  title      String
  artist     String
  mood       String
  durationMs Int
  audioUrl   String
  isActive   Boolean   @default(true)
  /// Import utilisateur (null = catalogue plateforme)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  products   Product[]

  @@index([userId])
  @@map("soundtrack")
}

enum WantedCondition {
  NEW_SHOP
  USED
}

enum WantedRequestStatus {
  OPEN
  MATCHED
  EXPIRED
  CANCELLED
}

enum WantedOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// Demande publique « Je cherche » (budget + neuf magasin ou occasion)
model WantedRequest {
  id          String              @id @default(cuid())
  buyerId     String
  buyer       User                @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  images      String[]
  category    String
  budgetCents Int
  currency    String              @default("USD")
  condition   WantedCondition
  city        String              @default("Kinshasa")
  commune     String?
  quartier    String?
  avenue      String?
  status      WantedRequestStatus @default(OPEN)
  expiresAt   DateTime
  acceptedOfferId String?         @unique
  acceptedOffer   WantedOffer?    @relation("AcceptedWantedOffer", fields: [acceptedOfferId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  offers        WantedOffer[]     @relation("WantedOffers")
  conversations Conversation[]
  product       Product?

  @@index([status, createdAt])
  @@index([buyerId, status])
  @@index([category, status])
  @@map("wanted_request")
}

model WantedOffer {
  id            String            @id @default(cuid())
  requestId     String
  request       WantedRequest     @relation("WantedOffers", fields: [requestId], references: [id], onDelete: Cascade)
  sellerUserId  String
  seller        User              @relation(fields: [sellerUserId], references: [id], onDelete: Cascade)
  shopId        String
  shop          Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  message       String?
  priceCents    Int
  images        String[]
  condition     WantedCondition
  sellerPhone   String?
  sellerAddress String?
  sellerCommune String?
  sellerQuartier String?
  sellerAvenue  String?
  sellerLat     Float?
  sellerLng     Float?
  status        WantedOfferStatus @default(PENDING)
  productId     String?           @unique
  product       Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  acceptedFor WantedRequest? @relation("AcceptedWantedOffer")

  @@unique([requestId, sellerUserId])
  @@index([requestId, status])
  @@index([sellerUserId])
  @@map("wanted_offer")
}

model Conversation {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     User     @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  wantedRequestId String?
  wantedRequest   WantedRequest? @relation(fields: [wantedRequestId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@unique([buyerId, shopId])
  @@index([shopId])
  @@index([wantedRequestId])
  @@map("conversation")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  /// Message urgent (soucis commande) — badge alerte côté vendeur
  isUrgent       Boolean      @default(false)
  /// Reste « non lu » jusqu'à réponse vendeur ou confirmation de changement
  requiresAck    Boolean      @default(false)
  readAt         DateTime?
  orderIssueId   String?
  orderIssue     OrderIssue?  @relation(fields: [orderIssueId], references: [id], onDelete: SetNull)
  kind           String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([requiresAck, isUrgent])
  @@map("message")
}

enum OrderIssueType {
  WRONG_SIZE
  WRONG_COLOR
  DEFECT
  WRONG_PRODUCT
  OTHER
}

enum OrderIssueStatus {
  OPEN
  SELLER_REPLIED
  CHANGE_CONFIRMED
  RESOLVED
  REJECTED
}

/// Signalement client (taille / erreur) → message urgent vendeur
model OrderIssue {
  id             String           @id @default(cuid())
  orderId        String
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyerId        String
  shopId         String
  type           OrderIssueType
  description    String
  status         OrderIssueStatus @default(OPEN)
  conversationId String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  resolvedAt     DateTime?

  messages Message[]

  @@index([orderId, status])
  @@index([shopId, status])
  @@map("order_issue")
}

// ─── Domain: cart ───────────────────────────────────────────────────

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@map("cart_item")
}

// ─── Domain: delivery zones & couriers ───────────────────────────────

enum ZoneKind {
  CENTER
  REMOTE
}

enum DeliveryPricingMode {
  PER_KM
  FLAT_ZONE
  COMMUNE
  BUS_STOP
}

model DeliveryZone {
  id              String              @id @default(cuid())
  name            String
  commune         String              @unique
  kind            ZoneKind
  pricingMode     DeliveryPricingMode @default(PER_KM)
  baseCents       Int
  ratePerKmCents  Int
  /// Forfait zone / commune (modes FLAT_ZONE, COMMUNE, fallback BUS_STOP)
  flatCents       Int?
  /// Arrêts de bus : [{ name, lat?, lng?, cents }]
  busStops        Json?
  centerLat       Float
  centerLng       Float
  /// Catalogue adresse (saisie GPS + ajouts utilisateurs)
  quartiers       String[] @default([])
  avenues         String[] @default([])
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  couriers Courier[]
  orders   Order[]
  shopRates ShopDeliveryRate[]

  @@map("delivery_zone")
}

model ShopDeliveryRate {
  id             String              @id @default(cuid())
  shopId         String
  shop           Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// null = tarif défaut boutique (toutes zones sans override)
  zoneId         String?
  zone           DeliveryZone?       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  pricingMode    DeliveryPricingMode @default(PER_KM)
  baseCents      Int                 @default(0)
  ratePerKmCents Int                 @default(0)
  flatCents      Int?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([shopId, zoneId])
  @@index([shopId])
  @@map("shop_delivery_rate")
}

model Courier {
  id          String   @id @default(cuid())
  name        String
  phone       String
  /// Adresse physique de base du livreur (quartier / avenue)
  address     String?
  lat         Float
  lng         Float
  zoneId      String?
  zone        DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  /// null = livreur plateforme ; sinon rattaché à une boutique
  shopId      String?
  shop        Shop?    @relation(fields: [shopId], references: [id], onDelete: SetNull)
  isAvailable Boolean  @default(true)
  /// Dernière position GPS (mise à jour livreur / mock)
  lastLat     Float?
  lastLng     Float?
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders Order[]

  @@index([isAvailable])
  @@index([shopId, isAvailable])
  @@map("courier")
}

// ─── Domain: wallet ─────────────────────────────────────────────────

model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balanceCents Int      @default(0)
  currency     String   @default("USD")
  usdCents     Int      @default(0)
  cdfCents     Int      @default(0)
  kwCents      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("wallet")
}

enum WalletTxnType {
  DEPOSIT
  PURCHASE
  REFUND
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  ESCROW_RELEASE
}

enum MobileMoneyProvider {
  MPESA
  ORANGE
  AIRTEL
  INTERNAL
}

enum WalletTxnStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

model WalletTransaction {
  id               String              @id @default(cuid())
  walletId         String
  wallet           Wallet              @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type             WalletTxnType
  amountCents      Int
  currency         String              @default("USD")
  balanceAfterCents Int?
  provider         MobileMoneyProvider @default(INTERNAL)
  phone            String?
  reference        String?
  status           WalletTxnStatus     @default(PENDING)
  metadata         Json?
  movementId       String?
  movement         MoneyMovement?      @relation(fields: [movementId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([walletId, createdAt])
  @@index([reference])
  @@index([movementId])
  @@map("wallet_transaction")
}

enum MoneyMovementKind {
  DEPOSIT
  P2P_MM
  P2P_BALANCE
}

enum MoneyMovementStatus {
  CREATED
  AWAITING_FUNDS
  POSTED
  EXPIRED
  FAILED
  REJECTED
}

enum NotifyOutboxStatus {
  PENDING
  SENT
  DEAD
}

enum PaymentAuditActor {
  USER
  SYSTEM
  OWNER
}

/// Unité de paiement : 1 clé d’idempotence = 1 mouvement.
model MoneyMovement {
  id                   String               @id @default(cuid())
  kind                 MoneyMovementKind
  status               MoneyMovementStatus  @default(CREATED)
  payerUserId          String
  payer                User                 @relation("MovementPayer", fields: [payerUserId], references: [id], onDelete: Cascade)
  beneficiaryUserId    String?
  beneficiary          User?                @relation("MovementBeneficiary", fields: [beneficiaryUserId], references: [id], onDelete: SetNull)
  amountCents          Int
  currency             String               @default("USD")
  provider             MobileMoneyProvider  @default(INTERNAL)
  phone                String?
  clientIdempotencyKey String               @unique
  providerReference    String?              @unique
  expiresAt            DateTime?
  postedAt             DateTime?
  evidenceNote         String?
  metadata             Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  transactions         WalletTransaction[]
  outbox               NotifyOutbox[]
  audits               PaymentAudit[]

  @@index([payerUserId, createdAt])
  @@index([status, expiresAt])
  @@map("money_movement")
}

model NotifyOutbox {
  id         String             @id @default(cuid())
  movementId String
  movement   MoneyMovement      @relation(fields: [movementId], references: [id], onDelete: Cascade)
  eventKey   String
  payload    Json
  status     NotifyOutboxStatus @default(PENDING)
  attempts   Int                @default(0)
  lastError  String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([movementId, eventKey])
  @@index([status, createdAt])
  @@map("notify_outbox")
}

model PaymentAudit {
  id           String            @id @default(cuid())
  movementId   String?
  movement     MoneyMovement?    @relation(fields: [movementId], references: [id], onDelete: SetNull)
  actorUserId  String?
  actor        User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorType    PaymentAuditActor @default(USER)
  action       String
  requestId    String?
  ip           String?
  fromStatus   String?
  toStatus     String?
  detail       Json?
  createdAt    DateTime          @default(now())

  @@index([movementId, createdAt])
  @@index([createdAt])
  @@map("payment_audit")
}

/// Numéros e-money par réseau (max 1 Airtel / Orange / Vodacom M-Pesa).
model UserMoneyContact {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  MobileMoneyProvider
  phone     String
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([userId, provider])
  @@unique([phone])
  @@index([userId])
  @@map("user_money_contact")
}

// ─── Domain: orders & fulfillment ───────────────────────────────────

enum FulfillmentType {
  DELIVERY
  PICKUP
}

/// Un QR par boutique et par paiement (N articles). Clos au dernier remis / annulé.
model ShopHandover {
  id          String    @id @default(cuid())
  buyerId     String
  buyer       User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  shopId      String
  shop        Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  code        String    @unique
  qrPayload   String
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  orders Order[]

  @@index([shopId, completedAt])
  @@index([buyerId, createdAt])
  @@map("shop_handover")
}

enum OrderStatus {
  PAID
  ASSIGNED
  FULFILLING
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  AWAITING_CONFIRM
  PICKED_UP
  DELIVERED
  FAILED
  REFUNDED
  CANCELLED
}

model Order {
  id                 String          @id @default(cuid())
  buyerId            String
  buyer              User            @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Cascade)
  shopId             String
  shop               Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId          String
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productCents       Int
  shippingCents      Int             @default(0)
  protectionFeeCents Int             @default(0)
  totalCents         Int
  /// @deprecated use productCents / totalCents — kept for legacy rows
  amountCents        Int             @default(0)
  fulfillmentType    FulfillmentType @default(PICKUP)
  deliveryCity       String?
  deliveryAddress    String?
  deliveryCommune    String?
  deliveryQuartier   String?
  deliveryAvenue     String?
  deliveryParcelle   String?
  deliveryLat        Float?
  deliveryLng        Float?
  contactPhone       String?
  optionColor        String?
  optionSize         String?
  escrowReleasedAt   DateTime?
  handoverId         String?
  handover           ShopHandover?   @relation(fields: [handoverId], references: [id], onDelete: SetNull)
  zoneId             String?
  zone               DeliveryZone?   @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  courierId          String?
  courier            Courier?        @relation(fields: [courierId], references: [id], onDelete: SetNull)
  distanceKm         Float?
  /// Distance livreur → client (km) au moment de l'assignation / MAJ GPS
  courierDistanceKm  Float?
  /// ETA minutes (trafic inclus)
  etaMinutes         Int?
  etaAt              DateTime?
  /// Client déjà notifié à ~100 m
  proximityNotifiedAt DateTime?
  status             OrderStatus     @default(PAID)
  paidAt             DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  pickupReceipt  PickupReceipt?
  deliveryEvents DeliveryEvent[]
  notifications  NotificationLog[]
  issues         OrderIssue[]

  @@index([buyerId, createdAt])
  @@index([shopId, status])
  @@index([courierId])
  @@index([handoverId])
  @@map("order")
}

/// Reçu / preuve de remise (retrait boutique OU livraison) — QR à scanner
model PickupReceipt {
  id         String    @id @default(cuid())
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  code       String    @unique
  qrPayload  String
  expiresAt  DateTime?
  /// Vendeur a scanné le QR / saisi le code — en attente confirmation client
  scannedAt  DateTime?
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("pickup_receipt")
}

model DeliveryEvent {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String?
  actorUserId String?
  actor       User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())

  @@index([orderId, createdAt])
  @@map("delivery_event")
}

// ─── Messaging plateforme (config owner Chip Shop) ─────────────────

enum WhatsappProvider {
  klambo
  infobip
}

enum MsgChannel {
  whatsapp
  sms
  email
}

/// Config unique (org système) — Klambo / Infobip SMS / Infobip WhatsApp
model MessagingConfig {
  id                    String           @id @default(cuid())
  organizationId        String           @unique
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  whatsappProvider      WhatsappProvider @default(klambo)
  /// Klambo
  klamboApiKeyEnc       String?
  klamboBaseUrl         String           @default("https://whatsapp-api.klambocore.com")
  klamboDefaultCountry  String           @default("CD")
  /// Infobip SMS
  smsApiKeyEnc          String?
  smsBaseUrl            String           @default("https://l2gerd.api.infobip.com")
  smsSender             String           @default("ChipShop")
  /// Infobip WhatsApp
  waApiKeyEnc           String?
  waBaseUrl             String           @default("https://l2gerd.api.infobip.com")
  waFromNumber          String?
  notifySms             Boolean          @default(true)
  notifyWhatsapp        Boolean          @default(true)
  notifyEmail           Boolean          @default(true)
  brandPrefix           String           @default("Chip Shop")
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@map("messaging_config")
}

/// Templates uniques owner — partagés par tous les vendeurs
model MessageTemplate {
  id                  String     @id @default(cuid())
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Clé événement: COURIER_ASSIGNED, COURIER_NEAR_100M, PICKED_UP…
  eventKey            String
  name                String
  channel             MsgChannel @default(whatsapp)
  body                String
  infobipTemplateName String?
  infobipLanguage     String     @default("fr")
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@unique([organizationId, eventKey, channel])
  @@index([organizationId, eventKey])
  @@map("message_template")
}

model NotificationLog {
  id        String   @id @default(cuid())
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  eventKey  String
  channel   MsgChannel
  toPhone   String
  body      String
  status    String   @default("SENT")
  provider  String?
  error     String?
  createdAt DateTime @default(now())

  @@index([orderId, eventKey])
  @@map("notification_log")
}

// ─── KYC Phase B — vérification vendeur pro ─────────────────────────

enum KycStatus {
  NONE
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum SellerType {
  INDIVIDUAL
  BUSINESS
}

model SellerKyc {
  id           String      @id @default(cuid())
  userId       String      @unique
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       KycStatus   @default(NONE)
  sellerType   SellerType?
  legalName    String?
  phone        String?
  idNumber     String?
  idFrontUrl   String?
  idBackUrl    String?
  selfieUrl    String?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?       @relation("KycReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectReason String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@map("seller_kyc")
}
