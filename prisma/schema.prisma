}

model ProductCreatorShare {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([productId, userId])
  @@index([userId])
  @@map("product_creator_share")
}

model BrandCampaign {
  id          String    @id @default(cuid())
  title       String
  kind        String    @default("FEED")
  /// DISCOVERY | ENGAGEMENT | CONVERSION
  objective   String    @default("DISCOVERY")
  category    String?
  budgetCents Int       @default(0)
  currency    String    @default("USD")
  status      String    @default("DRAFT")
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  ownerUserId String?
  owner       User?     @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  impressions Int       @default(0)
  clicks      Int       @default(0)
  conversions Int       @default(0)
  ctaUrl      String?
  mediaUrl    String?
  body        String?
  productId   String?
  influencerUserId String?
  influencer  User?     @relation("CampaignInfluencer", fields: [influencerUserId], references: [id], onDelete: SetNull)
  eventId     String?
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)
  challenges  DailyChallenge[]

  @@index([status, startsAt])
