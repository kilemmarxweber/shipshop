DATABASE_URL="postgresql://chipshop:chipshop@localhost:5433/chipshop?schema=public"
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="ShipShop"
NEXT_PUBLIC_APP_NAME="ShipShop"
UPLOAD_DIR=C:/chipshop-uploads
#UPLOAD_DIR=/var/www/chipshop-uploads
NEXT_PUBLIC_UPLOAD_URL=/uploads

# Caisses Mobile Money ShipShop (collecte — pas 3 soldes client, pas Wave SN)
SHIPSHOP_MSISDN_MPESA=+243810000100
SHIPSHOP_MSISDN_ORANGE=+243890000100
SHIPSHOP_MSISDN_AIRTEL=+243990000100

# Catalogue NSFW — AWS Rekognition DetectModerationLabels
# Sans AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY : pas de scan, upload inchangé.
MODERATION_PROVIDER=rekognition
# true en prod : refuse l'upload si Rekognition est down (clés présentes)
MODERATION_FAIL_CLOSED=true
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# ffmpeg : compression vidéo + scan frames
# Windows (exemple WinGet) — décommenter en local si besoin
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# VPS : sudo apt install -y ffmpeg
# FFMPEG_PATH=/usr/bin/ffmpeg
# Seed local uniquement (jamais en prod, jamais de mot de passe réel dans Git)
# SEED_EMAIL="demo@chipshop.cd"
# SEED_PASSWORD="demo12345"
