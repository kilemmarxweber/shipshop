# Instance systemd : anubis@shipshop.service
# Fichier cible VPS : /etc/anubis/shipshop.env

# Anubis écoute en local uniquement (Nginx → Anubis → Node)
BIND=127.0.0.1:8923
BIND_NETWORK=tcp

# Upstream = app Next.js / PM2
TARGET=http://127.0.0.1:3000

# Staging : challenge léger (augmenter plus tard si OK)
DIFFICULTY=2

# Métriques locales seulement (ne pas ouvrir sur Internet)
METRICS_BIND=127.0.0.1:9091
METRICS_BIND_NETWORK=tcp

POLICY_FNAME=/etc/anubis/shipshop.botPolicies.yaml

# Derrière Nginx TLS
# (Nginx doit envoyer X-Forwarded-Proto / X-Real-IP — déjà dans le snippet)
